{
  "info": {
    "_postman_id": "b6c9d3c0-1234-4e4f-9f11-fault-locator-api-0001",
    "name": "Fault Locator API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Fault Locator API endpoints (devices, teams, faults, assignments, deployments, roles). Set the {{base_url}} and {{auth_token}} collection variables before running requests."
  },
  "variable": [
    {"key": "base_url", "value": "http://localhost:8000/api/fault-locator", "type": "string"},
    {"key": "auth_token", "value": "", "type": "string"}
  ],
  "item": [
    {
      "name": "Devices",
      "item": [
        {"name": "List Devices", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"}], "url": "{{base_url}}/devices/"}},
        {"name": "Create Device", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"},{"key": "Content-Type","value": "application/json"}], "url": "{{base_url}}/devices/", "body": {"mode": "raw", "raw": "{\n  \"serial_number\": \"SN-001\",\n  \"description\": \"Ground probe kit\"\n}"}}},
        {"name": "Retrieve Device", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"}], "url": "{{base_url}}/devices/1/"}},
        {"name": "Update Device", "request": {"method": "PATCH", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"},{"key": "Content-Type","value": "application/json"}], "url": "{{base_url}}/devices/1/", "body": {"mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}"}}}
      ]
    },
    {
      "name": "Teams",
      "item": [
        {"name": "List Teams", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"}], "url": "{{base_url}}/teams/"}},
        {"name": "Create Team", "request": {"method": "POST", "header": [{"key": "Authorization", "value": "Token {{auth_token}}"},{"key": "Content-Type","value": "application/json"}], "url": "{{base_url}}/teams/", "body": {"mode":"raw","raw":"{\n  \"name\": \"Team Alpha\"\n}"}}},
        {"name": "Add Member", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/teams/1/add_member/", "body": {"mode": "raw", "raw": "{\n  \"user_id\": 2\n}"}}},
        {"name": "Remove Member", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/teams/1/remove_member/", "body": {"mode": "raw", "raw": "{\n  \"user_id\": 2\n}"}}}
      ]
    },
    {
      "name": "Faults",
      "item": [
        {"name": "List Faults", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Token {{auth_token}}"}], "url": "{{base_url}}/faults/"}},
        {"name": "Create Fault", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/faults/", "body": {"mode": "raw", "raw": "{\n  \"description\": \"Line down near pole 14\",\n  \"depot_id\": 1\n}"}}},
        {"name": "Prioritize Fault", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/faults/1/prioritize/", "body": {"mode": "raw", "raw": "{\n  \"priority\": 4\n}"}}},
        {"name": "Update Fault Status", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/faults/1/update_status/", "body": {"mode": "raw", "raw": "{\n  \"status\": \"located\"\n}"}}}
      ]
    },
    {
      "name": "Assignments",
      "item": [
        {"name": "List Assignments", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Token {{auth_token}}"}], "url": "{{base_url}}/assignments/"}},
        {"name": "Create Assignment", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/assignments/", "body": {"mode": "raw", "raw": "{\n  \"fault_id\": 1,\n  \"team_id\": 1,\n  \"device_id\": 1\n}"}}}
      ]
    },
    {
      "name": "Device Assignments",
      "item": [
        {"name": "List Device Assignments", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Token {{auth_token}}"}], "url": "{{base_url}}/device-assignments/"}},
        {"name": "Create Device Assignment", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/device-assignments/", "body": {"mode": "raw", "raw": "{\n  \"device_id\": 1,\n  \"team_id\": 1,\n  \"notes\": \"Initial allocation\"\n}"}}}
      ]
    },
    {
      "name": "Deployments",
      "item": [
        {"name": "List Deployments", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Token {{auth_token}}"}], "url": "{{base_url}}/deployments/"}},
        {"name": "Create Deployment", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/deployments/", "body": {"mode": "raw", "raw": "{\n  \"team_id\": 1,\n  \"depot_id\": 1,\n  \"deployment_notes\": \"Cover outage cluster A\"\n}"}}},
        {"name": "Recall Deployment", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/deployments/1/recall/", "body": {"mode": "raw", "raw": "{}"}}}
      ]
    },
    {
      "name": "Roles",
      "item": [
        {"name": "List Roles", "request": {"method": "GET", "header": [{"key": "Authorization","value": "Token {{auth_token}}"}], "url": "{{base_url}}/roles/"}},
        {"name": "Assign Role", "request": {"method": "POST", "header": [{"key": "Authorization","value": "Token {{auth_token}}"},{"key": "Content-Type","value":"application/json"}], "url": "{{base_url}}/roles/", "body": {"mode": "raw", "raw": "{\n  \"user_id\": 2,\n  \"role\": \"team_leader\"\n}"}}}
      ]
    }
  ]
}
